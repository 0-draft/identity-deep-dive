  "_comment": "Datatracker state names by stage, furthest first. Read by web/src/lib/lifecycle.ts (the progress board) and scripts/landscape/refresh.py (the spec map), so both place a draft the same way. A draft in an inactive state is no longer progressing.",
  "stages": [
    ["rfced", ["RFC Ed Queue", "RFC-Ed-Ack", "AUTH48", "AUTH48-DONE", "EDIT", "MISSREF", "REF", "TO"]],
    ["iesg", [
      "Publication Requested",
      "Submitted to IESG for Publication",
      "AD Evaluation",
      "IESG Evaluation",
      "IESG Evaluation - Defer",
      "In Last Call",
      "Waiting for AD Go-Ahead",
      "Waiting for Writeup",
      "Approved-announcement to be sent",
      "Approved-announcement sent"
    ]],
    ["wglc", ["In WG Last Call", "WG Consensus: Waiting for Write-Up", "Waiting for WG Chair Go-Ahead"]]
  ],
  "inactive": ["Expired", "Dead", "Replaced", "Withdrawn by Submitter", "Withdrawn by IETF"]
}
