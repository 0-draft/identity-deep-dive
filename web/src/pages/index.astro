---
import Layout from "../layouts/Layout.astro";
import InsightItem from "../components/InsightItem.astro";
import { TRACKS, allInsights, briefing, type Insight } from "../lib/tracks";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const items = allInsights();
const RANK = { substantive: 0, "new-proposal": 1, discussion: 2, editorial: 3, routine: 4 } as const;
const lead = [...items].sort((a, b) => RANK[a.significance] - RANK[b.significance] || (a.first_seen < b.first_seen ? 1 : -1))[0];
const rest = items.filter((i) => i !== lead);

const byDay = new Map<string, Insight[]>();
for (const i of rest) byDay.set(i.first_seen, [...(byDay.get(i.first_seen) ?? []), i]);
const dayLabel = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", timeZone: "UTC" });

const tracks = TRACKS.map((t) => ({ meta: t, b: briefing(t.id) }));
---

<Layout title="Identity Deep Dive">
  <section aria-labelledby="lead" class="mb-12">
    <h1 id="lead" class="max-w-[40ch] text-[15px] text-muted">
      What changed in identity standards, explained in one line, a diagram and the people it affects.
    </h1>
    {lead ? (
      <div class="mt-5">
        <InsightItem item={lead} variant="lead" showTrack openDiagram />
      </div>
    ) : (
      <p class="mt-5 max-w-[60ch] text-muted">
        No explanations yet. They appear after the next collection run finds a new draft revision, mailing-list thread or pull request.
      </p>
    )}
  </section>

  <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <section aria-labelledby="feed">
      <h2 id="feed" class="headline text-xl">Everything else from the last few days</h2>
      {rest.length === 0 && <p class="mt-3 text-muted">Nothing else yet.</p>}
      {[...byDay.entries()].map(([day, list]) => (
        <div class="mt-6">
          <h3 class="border-b border-rule pb-1.5 text-sm font-semibold text-muted">{dayLabel(day)}</h3>
          <div class="mt-3 space-y-3">
            {list.map((item) => <InsightItem item={item} variant="compact" showTrack />)}
          </div>
        </div>
      ))}
    </section>

    <aside aria-labelledby="tracks" class="self-start lg:sticky lg:top-6">
      <h2 id="tracks" class="headline text-xl">Tracks</h2>
      <ul class="mt-4 space-y-6">
        {tracks.map(({ meta, b }) => (
          <li>
            <a class="text-[17px] font-semibold" href={`${base}/${meta.id}/`}>{meta.name}</a>
            <p class="mt-0.5 text-sm text-muted">{meta.scope}</p>
            {b.brief && <p class="mt-2 text-[15px] leading-snug">{b.brief.text}</p>}
          </li>
        ))}
      </ul>
    </aside>
  </div>
</Layout>
