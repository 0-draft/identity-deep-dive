---
import Layout from "../../layouts/Layout.astro";
import CandidateList from "../../components/CandidateList.astro";
import InsightItem from "../../components/InsightItem.astro";
import {
  TRACKS,
  briefing,
  latestDaily,
  latestWeekly,
  topCandidates,
  type TrackId,
} from "../../lib/tracks";
import { renderMarkdown } from "../../lib/markdown";

export function getStaticPaths() {
  return TRACKS.map((t) => ({ params: { track: t.id } }));
}

const { track } = Astro.params;
const trackId = track as TrackId;
const meta = TRACKS.find((t) => t.id === trackId)!;

const daily = latestDaily(trackId);
const weekly = latestWeekly(trackId);
const candidates = topCandidates(trackId);
const { brief, items: allItems } = briefing(trackId);
const ITEM_LIMIT = 30;
const items = allItems.slice(0, ITEM_LIMIT);
const updated = brief
  ? new Date(brief.at).toLocaleString("en-GB", { day: "numeric", month: "long", hour: "2-digit", minute: "2-digit", timeZone: "UTC" }) + " UTC"
  : null;
---

<Layout title={`${meta.name}: Identity Deep Dive`} current={trackId}>
  <header class="mb-10 max-w-[70ch]">
    <h1 class="headline text-3xl sm:text-4xl">{meta.name}</h1>
    <p class="mt-2 text-muted">{meta.scope}.</p>
    <p class="mt-1 flex flex-wrap gap-x-5 text-sm">
      {meta.href && <a href={meta.href} rel="noreferrer">{meta.org} page</a>}
      <a href={`https://github.com/0-draft/identity-deep-dive/tree/main/tracks/${trackId}`} rel="noreferrer">Collected data on GitHub</a>
    </p>
    {brief && (
      <blockquote class="mt-6 border-l-[3px] border-ink pl-5">
        <p class="headline text-[1.15rem] font-medium sm:text-[1.35rem]">{brief.text}</p>
        <p class="mt-2 text-sm text-muted">Updated {updated}</p>
      </blockquote>
    )}
  </header>

  <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_21rem]">
    <section aria-labelledby="changes">
      <h2 id="changes" class="headline text-xl">What changed</h2>
      {items.length === 0 ? (
        <p class="mt-3 max-w-[60ch] text-muted">
          No explanations in the last seven days. The tables below still show the latest collected state.
        </p>
      ) : (
        <div class="mt-4 space-y-3">
          {items.map((item, i) => <InsightItem item={item} openDiagram={i === 0} />)}
        </div>
      )}

      <div class="mt-12 space-y-4">
        {daily && (
          <details class="disclosure rounded-md border border-rule bg-surface px-5 py-4">
            <summary>Full daily report for {daily.name.replace(/\.md$/, "")}</summary>
            <article class="prose-report mt-4" set:html={renderMarkdown(daily.body)} />
          </details>
        )}
        {weekly && (
          <details class="disclosure rounded-md border border-rule bg-surface px-5 py-4">
            <summary>Weekly digest {weekly.name.replace(/\.md$/, "")}</summary>
            <article class="prose-report mt-4" set:html={renderMarkdown(weekly.body)} />
          </details>
        )}
      </div>
    </section>

    <aside aria-labelledby="queue" class="self-start lg:sticky lg:top-6">
      <h2 id="queue" class="headline text-xl">Deep-dive queue</h2>
      <p class="mt-1 mb-4 text-sm text-muted">Ranked by activity and lifecycle. Raised or lowered where this week's material gave a reason.</p>
      <CandidateList candidates={candidates} />
    </aside>
  </div>
</Layout>
