---
import { href, pick, t, type Lang } from "../lib/i18n";
import { SIGNIFICANCE_LABEL, anchorId, trackName, type Pick } from "../lib/tracks";

interface Props {
  picks: Pick[];
  lang: Lang;
}
const { picks, lang } = Astro.props;
---

{picks.length === 0 ? (
  <p class="max-w-[60ch] text-muted">{t(lang, "noPicks")}</p>
) : (
  <ol class="space-y-3">
    {picks.map(({ insight, why, why_ja }, i) => (
      <li class="item grid grid-cols-[2.25rem_minmax(0,1fr)] gap-x-3 bg-surface px-5 py-5 sm:px-6" data-sig={insight.significance}>
        <span class="headline pt-0.5 text-2xl text-muted" aria-hidden="true">{i + 1}</span>
        <div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <span class="sig">{SIGNIFICANCE_LABEL[insight.significance][lang]}</span>
            <a class="text-[13px] text-muted" href={href(lang, `${insight.track}/`)}>{trackName(insight.track)}</a>
            {lang === "ja" && !insight.headline_ja && <span class="text-[13px] text-muted">{t(lang, "untranslated")}</span>}
          </div>
          <h3 class:list={["headline mt-1.5 text-ink", i === 0 ? "text-[1.6rem] sm:text-[1.9rem]" : "text-[1.3rem]"]}>
            {pick(lang, insight.headline, insight.headline_ja)}
          </h3>
          <p class="mt-2 max-w-[68ch] text-[16px] leading-relaxed">{pick(lang, why, why_ja)}</p>
          <p class="mt-3 text-sm">
            <a href={`${href(lang, `${insight.track}/`)}#${anchorId(insight.id)}`}>{t(lang, "readExplanation")}</a>
          </p>
        </div>
      </li>
    ))}
  </ol>
)}
