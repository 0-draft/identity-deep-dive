---
import { formatDay, href, pick, pickList, t, type Lang } from "../lib/i18n";
import { SIGNIFICANCE_LABEL, anchorId, trackName, type Insight } from "../lib/tracks";

interface Props {
  item: Insight;
  lang: Lang;
  /** "lead": everything shown. "full": a track page entry, summary shown,
   *  extras behind disclosures. "compact": a feed row, the line and the
   *  source until opened. */
  variant?: "lead" | "full" | "compact";
  showTrack?: boolean;
  openDiagram?: boolean;
}
const { item, lang, variant = "full", showTrack = false, openDiagram = false } = Astro.props;
const headline = pick(lang, item.headline, item.headline_ja) || item.title;
const summary = pick(lang, item.summary, item.summary_ja);
const useCases = pickList(lang, item.use_cases, item.use_cases_ja);
const untranslated = lang === "ja" && !item.headline_ja;
const hasAffects = useCases.length > 0 || item.related.length > 0;
const headingSize = { lead: "text-[1.75rem] sm:text-[2.1rem]", full: "text-[1.3rem]", compact: "text-[1.15rem]" }[variant];
---

<article id={variant === "compact" ? undefined : anchorId(item.id)} class="item scroll-mt-6 bg-surface px-5 py-5 sm:px-6" data-sig={item.significance}>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
    <span class="sig">{SIGNIFICANCE_LABEL[item.significance][lang]}</span>
    {showTrack && <a class="text-[13px] text-muted" href={href(lang, `${item.track}/`)}>{trackName(item.track)}</a>}
    {variant !== "compact" && <time class="text-[13px] text-muted" datetime={item.first_seen}>{formatDay(lang, item.first_seen)}</time>}
    {untranslated && <span class="text-[13px] text-muted">{t(lang, "untranslated")}</span>}
  </div>

  <h3 class:list={["headline mt-2 text-ink", headingSize]}>{headline}</h3>

  {variant !== "compact" && (
    <p class:list={["mt-3 max-w-[68ch] text-muted", variant === "lead" ? "text-[17px]" : "text-[15px]"]}>{summary}</p>
  )}

  <p class="mt-2.5 text-sm">
    {item.url ? <a href={item.url} rel="noreferrer">{item.title}</a> : item.title}
  </p>

  {variant === "compact" ? (
    <details class="disclosure mt-3" data-diagram={item.diagram ? "" : undefined}>
      <summary>{t(lang, "readExplanation")}</summary>
      <p class="mt-3 max-w-[68ch] text-[15px] text-muted">{summary}</p>
      {item.diagram && (
        <div class="diagram-frame">
          <pre class="mermaid">{item.diagram}</pre>
        </div>
      )}
      {useCases.length > 0 && (
        <ul class="mt-3 max-w-[68ch] list-disc space-y-1.5 pl-5 text-[15px]">
          {useCases.map((u) => <li>{u}</li>)}
        </ul>
      )}
      {item.related.length > 0 && (
        <ul class="mt-3 max-w-[68ch] space-y-1.5 text-[15px]">
          {item.related.map((r) => (
            <li>
              {t(lang, "relatedIn")} <a href={href(lang, `${r.track}/`)}>{trackName(r.track)}</a>: <code class="text-[13px]">{r.name}</code>. {pick(lang, r.note, r.note_ja)}
            </li>
          ))}
        </ul>
      )}
    </details>
  ) : (
    <>
      {item.diagram && (
        <details class="disclosure mt-4" data-diagram open={openDiagram}>
          <summary>{t(lang, "howItWorks")}</summary>
          <div class="diagram-frame">
            <pre class="mermaid">{item.diagram}</pre>
          </div>
        </details>
      )}
      {hasAffects && (
        <details class="disclosure mt-3" open={variant === "lead"}>
          <summary>{t(lang, "whoAffects")}</summary>
          <div class="mt-3 max-w-[68ch] space-y-3 text-[15px]">
            {useCases.length > 0 && (
              <ul class="list-disc space-y-1.5 pl-5">
                {useCases.map((u) => <li>{u}</li>)}
              </ul>
            )}
            {item.related.length > 0 && (
              <ul class="space-y-1.5">
                {item.related.map((r) => (
                  <li>
                    {t(lang, "relatedIn")} <a href={href(lang, `${r.track}/`)}>{trackName(r.track)}</a>: <code class="text-[13px]">{r.name}</code>. {pick(lang, r.note, r.note_ja)}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </details>
      )}
    </>
  )}
</article>
