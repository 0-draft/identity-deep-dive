---
import type { Candidate } from "../lib/tracks";

interface Props {
  candidates: Candidate[];
}
const { candidates } = Astro.props;
const label = { high: "Raised", low: "Lowered" } as const;
---

{candidates.length === 0 ? (
  <p class="text-sm text-muted">Nothing scores above the threshold right now.</p>
) : (
  <ol class="divide-y divide-rule border-y border-rule">
    {candidates.map((c) => (
      <li class="py-3">
        <div class="flex items-baseline justify-between gap-3">
          <p class="min-w-0 break-words text-[15px] font-medium leading-snug">
            {c.url ? <a href={c.url} rel="noreferrer">{c.title}</a> : c.title}
          </p>
          <span class="shrink-0 text-sm tabular-nums text-muted" title="Heuristic score">{c.score}</span>
        </div>
        {(c.draft_name || c.repo) && <p class="mt-0.5 font-mono text-xs text-muted">{c.draft_name ?? c.repo}</p>}
        {c.ai_priority && c.ai_priority !== "normal" && (
          <p class="mt-1.5 text-[13px] leading-snug">
            <span class:list={["font-semibold", c.ai_priority === "high" ? "text-sig-substantive" : "text-muted"]}>
              {label[c.ai_priority]}
            </span>
            <span class="text-muted">: {c.ai_note}</span>
          </p>
        )}
        {c.state_labels?.length ? (
          <p class="mt-1 text-xs text-muted">{c.state_labels.join(", ")}</p>
        ) : null}
      </li>
    ))}
  </ol>
)}
