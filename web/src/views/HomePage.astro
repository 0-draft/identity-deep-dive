---
import Layout from "../layouts/Layout.astro";
import Board from "../components/Board.astro";
import InsightItem from "../components/InsightItem.astro";
import PickList from "../components/PickList.astro";
import TopicMap from "../components/TopicMap.astro";
import { formatDay, t, type Lang } from "../lib/i18n";
import { allInsights, synthesis, type Insight } from "../lib/tracks";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const { picks, topics } = synthesis();
const picked = new Set(picks.map((p) => p.insight.id));
// Up to four runs a day for seven days can add hundreds of items; the home
// page lists the most recent, and each track page has the rest.
const FEED_LIMIT = 40;
// Routine items (minor, or too thin to explain) stay on the track pages.
const rest = allInsights()
  .filter((i) => !picked.has(i.id) && i.significance !== "routine")
  .slice(0, FEED_LIMIT);
const byDay = new Map<string, Insight[]>();
for (const i of rest) byDay.set(i.first_seen, [...(byDay.get(i.first_seen) ?? []), i]);
---

<Layout title={t(lang, "siteTitle")} lang={lang} path="">
  <p class="max-w-[52ch] text-[15px] text-muted">{t(lang, "intro")}</p>

  <section aria-labelledby="week" class="mt-6">
    <h1 id="week" class="headline text-3xl sm:text-4xl">{t(lang, "thisWeek")}</h1>
    <p class="mt-1 mb-5 text-sm text-muted">{t(lang, "thisWeekNote")}</p>
    <PickList picks={picks} lang={lang} />
  </section>

  <section aria-labelledby="board" class="mt-14">
    <h2 id="board" class="headline text-2xl">{t(lang, "board")}</h2>
    <p class="mt-1 mb-4 max-w-[70ch] text-sm text-muted">{t(lang, "boardNote")} {t(lang, "boardOpenId")}</p>
    <Board lang={lang} />
  </section>

  {topics.length > 0 && (
    <section aria-labelledby="topics" class="mt-14">
      <h2 id="topics" class="headline text-2xl">{t(lang, "topics")}</h2>
      <p class="mt-1 mb-4 text-sm text-muted">{t(lang, "topicsNote")}</p>
      <TopicMap topics={topics} lang={lang} />
    </section>
  )}

  <section aria-labelledby="feed" class="mt-14">
    <h2 id="feed" class="headline text-2xl">{t(lang, "allChanges")}</h2>
    {rest.length === 0 && <p class="mt-3 text-muted">{picks.length ? t(lang, "nothingElse") : t(lang, "noExplanations")}</p>}
    <div class="max-w-4xl">
      {[...byDay.entries()].map(([day, list]) => (
        <div class="mt-6">
          <h3 class="border-b border-rule pb-1.5 text-sm font-semibold text-muted">{formatDay(lang, day, true)}</h3>
          <div class="mt-3 space-y-3">
            {list.map((item) => <InsightItem item={item} lang={lang} variant="compact" showTrack />)}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
