---
import Layout from "../layouts/Layout.astro";
import { href, t, type Lang } from "../lib/i18n";
import { rfc as loadRfc } from "../lib/rfc";
import { rfcSpecs } from "../lib/rfcpages";

interface Props {
  lang: Lang;
  id: string;
}
const { lang, id } = Astro.props;
const spec = rfcSpecs().find((s) => s.id === id)!;
const doc = loadRfc(spec.rfcNumber)!;
const tr = doc.translation;
const title = `RFC ${doc.number} ${t(lang, "rfcTitle")}: ${doc.title}`;
const anchor = (sid: string) => `s-${sid.replace(/\./g, "-")}`;
// Section headings carry the number, as in the RFC, except the unnumbered
// ones (abstract, acknowledgements).
const numbered = (sid: string) => /^[\dA-Z]/.test(sid);
const sectionTitle = (s: (typeof doc.sections)[number], ja: boolean) => (ja && s.title_ja ? s.title_ja : s.title);
---

<Layout title={title} lang={lang} path={`map/${id}/rfc/`} current="map" description={`RFC ${doc.number}: ${doc.title}`}>
  <nav class="mb-4 text-sm text-muted">
    <a href={href(lang, "map/")}>{t(lang, "specBack")}</a> / <a href={href(lang, `map/${id}/`)}>{spec.name}</a>
  </nav>
  <header class="mb-6">
    <p class="text-sm font-semibold text-muted">RFC {doc.number} · {t(lang, "rfcTitle")}</p>
    <h1 class="headline mt-1 text-3xl break-words sm:text-4xl">{doc.title}</h1>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      <a href={doc.url} rel="noreferrer">{t(lang, "rfcOfficial")}</a>
      <a href={href(lang, `map/${id}/`)}>{t(lang, "rfcBack")}</a>
    </p>
    <p class="mt-3 max-w-[80ch] text-[13px] leading-relaxed text-muted">{t(lang, "rfcNotice")}</p>
    {tr ? (
      <p class="mt-2 text-[13px] text-muted">
        {Math.round(tr.coverage * 100)}% {t(lang, "rfcCoverage")}{tr.model && ` · ${t(lang, "rfcTranslatedBy")} ${tr.model}`} · {tr.translated_at.slice(0, 10)}
        {tr.stale && <span class="ml-2 font-medium text-ink">{t(lang, "rfcStale")}</span>}
      </p>
    ) : (
      <p class="mt-2 text-[13px] text-muted">{t(lang, "rfcNoTranslation")}</p>
    )}
  </header>

  <details class="disclosure mb-6">
    <summary>{t(lang, "rfcContents")}</summary>
    <ol class="mt-2 columns-1 gap-8 text-[13px] leading-relaxed sm:columns-2 lg:columns-3">
      {doc.sections.map((s) => (
        <li style={`padding-left:${(s.depth - 1) * 0.9}rem`}>
          <a href={`#${anchor(s.id)}`}>{numbered(s.id) && <span class="font-mono text-muted">{s.id}</span>} {sectionTitle(s, lang === "ja")}</a>
        </li>
      ))}
    </ol>
  </details>

  <div class="rfc sticky top-0 z-10 -mx-4 hidden grid-cols-2 gap-6 border-b border-rule bg-paper px-4 py-1.5 text-xs font-semibold text-muted sm:px-6 md:grid" style="top: env(safe-area-inset-top, 0px)">
    <span>{t(lang, "rfcEnglish")}</span>
    <span lang="ja">{t(lang, "rfcJapanese")}</span>
  </div>

  <div class="rfc mt-2 space-y-8">
    {doc.sections.map((s) => (
      <section id={anchor(s.id)} class="scroll-mt-10">
        <div class="rfc-row">
          <h2 class:list={["rfc-h", s.depth <= 1 ? "text-xl" : s.depth === 2 ? "text-lg" : "text-base"]}>
            {numbered(s.id) && <span class="mr-2 font-mono text-muted">{s.id}.</span>}{s.title}
          </h2>
          <h2 lang="ja" class:list={["rfc-h", s.depth <= 1 ? "text-xl" : s.depth === 2 ? "text-lg" : "text-base", !s.title_ja && "rfc-missing"]}>
            {numbered(s.id) && <span class="mr-2 font-mono text-muted">{s.id}.</span>}{s.title_ja ?? s.title}
          </h2>
        </div>
        {s.paragraphs.map((p) =>
          p.kind === "pre" ? (
            <div class="rfc-row rfc-pre">
              <pre class="rfc-code">{p.en}</pre>
              <pre class="rfc-code rfc-code-mirror" aria-hidden="true">{p.en}</pre>
            </div>
          ) : (
            <div class="rfc-row" id={`p-${p.id}`}>
              <p class:list={["rfc-p", p.kind === "li" && "rfc-li"]}>{p.en}</p>
              <p lang="ja" class:list={["rfc-p", p.kind === "li" && "rfc-li", !p.ja && "rfc-missing"]} title={p.ja ? undefined : t(lang, "rfcUntranslated")}>{p.ja ?? p.en}</p>
            </div>
          ),
        )}
      </section>
    ))}
  </div>
</Layout>

<style is:global>
  /* Two columns that stay aligned paragraph by paragraph: each pair is its
     own grid row, so a long translation stretches only its own row. On a
     phone the pair stacks, Japanese under English. */
  .rfc-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem 1.5rem;
    align-items: start;
    padding: 0.3rem 0;
  }
  @media (min-width: 768px) {
    .rfc-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .rfc-h {
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.3;
    margin-top: 0.5rem;
    text-wrap: balance;
  }
  .rfc-p {
    font-size: 14.5px;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .rfc-p[lang="ja"] {
    line-height: 1.85;
  }
  .rfc-li {
    padding-left: 1.25rem;
  }
  .rfc-missing {
    color: var(--color-muted);
  }
  .rfc-missing::after {
    content: " ·";
  }
  .rfc-code {
    margin: 0;
    overflow-x: auto;
    border-radius: 6px;
    background: var(--color-code-bg);
    color: var(--color-code-fg);
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.5;
    white-space: pre;
  }
  @media (max-width: 767.98px) {
    .rfc-code-mirror {
      display: none;
    }
  }
  /* Odd rows carry a faint ground so the eye can cross from left to right. */
  .rfc section > .rfc-row:nth-child(even) {
    background: color-mix(in srgb, var(--color-surface) 60%, transparent);
  }
</style>
