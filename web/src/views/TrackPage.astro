---
import Layout from "../layouts/Layout.astro";
import Board from "../components/Board.astro";
import CandidateList from "../components/CandidateList.astro";
import InsightItem from "../components/InsightItem.astro";
import { formatDateTime, href, pick, t, type Lang } from "../lib/i18n";
import { renderMarkdown } from "../lib/markdown";
import { localizeReport } from "../lib/report-i18n";
import { deepDive, deepDiveSlugs } from "../lib/deepdives";
import { TRACKS, briefing, latestDaily, latestWeekly, topCandidates, type TrackId } from "../lib/tracks";

interface Props {
  lang: Lang;
  track: TrackId;
}
const { lang, track } = Astro.props;
const meta = TRACKS.find((m) => m.id === track)!;

const daily = latestDaily(track);
const weekly = latestWeekly(track);
const candidates = topCandidates(track);
const { brief, items: allItems } = briefing(track);
const ITEM_LIMIT = 30;
const items = allItems.filter((i) => i.significance !== "routine").slice(0, ITEM_LIMIT);
// Minor items are listed last, folded, so they do not end the page.
const MINOR_LIMIT = 20;
const minorAll = allItems.filter((i) => i.significance === "routine");
const minor = minorAll.slice(0, MINOR_LIMIT);
const isIetf = track !== "openid";
const dives = deepDiveSlugs(track).map((s) => deepDive(track, s, lang));
---

<Layout title={`${meta.name}: ${t(lang, "siteTitle")}`} lang={lang} path={`${track}/`} current={track}>
  <header class="mb-10 max-w-[70ch]">
    <h1 class="headline text-3xl sm:text-4xl">{meta.name}</h1>
    <p class="mt-2 text-muted">{pick(lang, meta.scope, meta.scope_ja)}</p>
    <p class="mt-1 flex flex-wrap gap-x-5 text-sm">
      {meta.href && <a href={meta.href} rel="noreferrer">{meta.org} {t(lang, "sourcePage")}</a>}
      <a href={`https://github.com/0-draft/identity-deep-dive/tree/main/tracks/${track}`} rel="noreferrer">{t(lang, "dataOnGithub")}</a>
    </p>
    {brief && (
      <blockquote class="mt-6 border-l-[3px] border-ink pl-5">
        <p class="headline text-[1.15rem] font-medium sm:text-[1.35rem]">{pick(lang, brief.text, brief.text_ja)}</p>
        <p class="mt-2 text-sm text-muted">{t(lang, "updated")} {formatDateTime(lang, brief.at)}</p>
      </blockquote>
    )}
  </header>

  {isIetf && (
    <section aria-labelledby="board" class="mb-12">
      <h2 id="board" class="headline text-xl">{t(lang, "board")}</h2>
      <p class="mt-1 mb-4 text-sm text-muted">{t(lang, "boardNote")}</p>
      <Board lang={lang} only={track} />
    </section>
  )}

  <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_21rem]">
    <section aria-labelledby="changes">
      <h2 id="changes" class="headline text-xl">{t(lang, "whatChanged")}</h2>
      {items.length === 0 ? (
        <p class="mt-3 max-w-[60ch] text-muted">{t(lang, "noTrackExplanations")}</p>
      ) : (
        <div class="mt-4 space-y-3">
          {items.map((item, i) => <InsightItem item={item} lang={lang} openDiagram={i === 0} />)}
        </div>
      )}
      {minor.length > 0 && (
        <details class="disclosure mt-6">
          <summary>{t(lang, "minorChanges")} ({minorAll.length})</summary>
          <div class="mt-3 space-y-3">
            {minor.map((item) => <InsightItem item={item} lang={lang} variant="compact" />)}
          </div>
          {minorAll.length > MINOR_LIMIT && (
            <p class="mt-3 text-sm text-muted">+{minorAll.length - MINOR_LIMIT} {t(lang, "andMore")}</p>
          )}
        </details>
      )}

      <div class="mt-12 space-y-4">
        {daily && (
          <details class="disclosure rounded-md border border-rule bg-surface px-5 py-4">
            <summary>{t(lang, "dailyReport")} {daily.name.replace(/\.md$/, "")} {t(lang, "reportDataEnglish")}</summary>
            <article class="prose-report mt-4" set:html={renderMarkdown(localizeReport(daily.body, lang))} />
          </details>
        )}
        {weekly && (
          <details class="disclosure rounded-md border border-rule bg-surface px-5 py-4">
            <summary>{t(lang, "weeklyDigest")} {weekly.name.replace(/\.md$/, "")} {t(lang, "reportDataEnglish")}</summary>
            <article class="prose-report mt-4" set:html={renderMarkdown(localizeReport(weekly.body, lang))} />
          </details>
        )}
      </div>
    </section>

    <aside aria-labelledby="queue" class="self-start lg:sticky lg:top-6">
      {dives.length > 0 && (
        <section aria-labelledby="dives" class="mb-10">
          <h2 id="dives" class="headline text-xl">{t(lang, "deepDives")}</h2>
          <p class="mt-1 mb-4 text-sm text-muted">{t(lang, "deepDivesNote")}</p>
          <ul class="divide-y divide-rule border-y border-rule">
            {dives.map((d) => (
              <li class="py-3">
                <a class="text-[15px] font-medium break-words" href={href(lang, `${track}/deep-dives/${d.slug}/`)}>{d.title}</a>
                {d.oneLiner && <p class="mt-1 text-[13px] leading-snug text-muted">{d.oneLiner}</p>}
              </li>
            ))}
          </ul>
        </section>
      )}
      <h2 id="queue" class="headline text-xl">{t(lang, "queue")}</h2>
      <p class="mt-1 mb-4 text-sm text-muted">{t(lang, "queueNote")}</p>
      <CandidateList candidates={candidates} lang={lang} />
    </aside>
  </div>
</Layout>
