---
import "../styles/global.css";
import { href, t, type Lang } from "../lib/i18n";

interface Props {
  title: string;
  lang: Lang;
  /** Path of this page without the language prefix, e.g. "" or "oauth-wg/". */
  path: string;
  description?: string;
  current?: string;
}
const { title, lang, path, description = t(lang, "siteDescription"), current = "" } = Astro.props;

const other: Lang = lang === "en" ? "ja" : "en";
const navLinks = [
  { id: "ietf-wimse", href: href(lang, "ietf-wimse/"), label: "WIMSE" },
  { id: "oauth-wg", href: href(lang, "oauth-wg/"), label: "OAuth WG" },
  { id: "openid", href: href(lang, "openid/"), label: "OpenID" },
  { id: "map", href: href(lang, "map/"), label: t(lang, "navMap") },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Inline, so it needs no file under the Pages base path. Without one the
         browser asks for /favicon.ico at the domain root and logs a 404. -->
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%230b6e60'/%3E%3Ctext x='16' y='22.5' font-family='Georgia,serif' font-size='17' font-weight='600' fill='white' text-anchor='middle'%3Eid%3C/text%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />
    {lang === "ja" && (
      <link
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600&family=Noto+Serif+JP:wght@500;600&display=swap"
        rel="stylesheet"
      />
    )}
    <link rel="alternate" hreflang="en" href={href("en", path)} />
    <link rel="alternate" hreflang="ja" href={href("ja", path)} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-rule bg-surface">
        <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
          <a href={href(lang)} class="headline text-lg text-ink no-underline hover:no-underline">
            {t(lang, "siteTitle")}
          </a>
          <nav aria-label="Tracks" class="flex flex-wrap items-center gap-1 text-sm">
            {navLinks.map((l) => (
              <a
                href={l.href}
                aria-current={current === l.id ? "page" : undefined}
                class:list={[
                  "rounded px-2.5 py-1 no-underline hover:bg-paper hover:no-underline",
                  current === l.id ? "bg-paper font-semibold text-ink" : "text-muted",
                ]}
              >
                {l.label}
              </a>
            ))}
            <a
              href={href(other, path)}
              hreflang={other}
              lang={other}
              class="ml-2 rounded border border-rule px-2.5 py-1 text-muted no-underline hover:bg-paper hover:no-underline"
            >
              {t(lang, "switchLang")}
            </a>
          </nav>
        </div>
      </header>
      <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 sm:py-12">
        <slot />
      </main>
      <footer class="border-t border-rule bg-surface">
        <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-5 text-sm text-muted sm:px-6">
          <span>
            {t(lang, "footerBuilt")} <a href="https://github.com/0-draft/identity-deep-dive">0-draft/identity-deep-dive</a>. {t(lang, "footerProvenance")}
          </span>
          <span>{t(lang, "footerCadence")}</span>
        </div>
      </footer>
    </div>

    <script>
      // Diagrams render when their disclosure opens, so closed ones cost nothing
      // and mermaid measures them at their real width.
      const frames = document.querySelectorAll<HTMLDetailsElement>("details[data-diagram]");
      if (frames.length) {
        let ready: Promise<typeof import("mermaid").default> | null = null;
        const load = () =>
          (ready ??= import("mermaid").then(({ default: mermaid }) => {
            mermaid.initialize({
              startOnLoad: false,
              securityLevel: "strict",
              theme: "base",
              fontFamily: "Public Sans, system-ui, sans-serif",
              // Natural size, scrolled sideways on a phone. Shrunk to fit,
              // a sequence diagram's labels become unreadable.
              sequence: { useMaxWidth: false },
              flowchart: { useMaxWidth: false },
              themeVariables: {
                primaryColor: "#ffffff",
                primaryBorderColor: "#586274",
                primaryTextColor: "#1a2230",
                lineColor: "#586274",
                actorBkg: "#ffffff",
                actorBorder: "#1a2230",
                noteBkgColor: "#eef3f1",
                noteBorderColor: "#0b6e60",
                signalColor: "#1a2230",
                signalTextColor: "#1a2230",
              },
            });
            return mermaid;
          }));
        // Shrink a diagram wider than its frame, but not below 70%: smaller
        // than that the labels stop being readable, so it scrolls instead.
        const fit = (node: HTMLElement) => {
          const svg = node.querySelector("svg");
          const frame = node.closest<HTMLElement>(".diagram-frame");
          if (!svg || !frame) return;
          const natural = svg.viewBox.baseVal?.width || svg.getBoundingClientRect().width;
          const room = frame.clientWidth - 32;
          if (natural > room) svg.style.width = `${Math.max(room, natural * 0.7)}px`;
          svg.style.height = "auto";
        };
        const render = async (frame: HTMLDetailsElement) => {
          const nodes = Array.from(frame.querySelectorAll<HTMLElement>("pre.mermaid:not([data-processed])"));
          if (!nodes.length) return;
          const mermaid = await load();
          for (const node of nodes) {
            const source = node.textContent ?? "";
            try {
              await mermaid.parse(source);
              await mermaid.run({ nodes: [node] });
              fit(node);
            } catch {
              // Keep the source as text: still readable, unlike an error image.
              node.textContent = source;
              node.setAttribute("data-processed", "failed");
            }
          }
        };
        // Opened only where there is room; on a phone the map is a tap away.
        const wide = window.matchMedia("(min-width: 768px)").matches;
        frames.forEach((frame) => {
          if (wide && frame.hasAttribute("data-open-wide")) frame.open = true;
          if (frame.open) render(frame);
          frame.addEventListener("toggle", () => frame.open && render(frame));
        });
      }
    </script>
  </body>
</html>
